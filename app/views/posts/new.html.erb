<div class="page-header">

  <div>
    <h1>Create Post</h1>

    <p class="text-muted">
      Share a question, idea or laboratory topic with the community.
    </p>
  </div>

</div>


<div class="card post-form-card">

  <%= form_with model: @post do |f| %>

    <% if @post.errors.any? %>

      <div class="flash flash-error">

        <strong>
          Please correct the following errors:
        </strong>

        <ul>
          <% @post.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>

      </div>

    <% end %>


    <div class="form-group">

      <%= f.label :title %>

      <%= f.text_field :title,
                       placeholder: "Enter a descriptive title",
                       required: true %>

    </div>


    <div class="form-group">

      <%= f.label :category %>

      <%= f.select :category,
                   [
                     "Programming",
                     "Databases",
                     "Networks",
                     "Other"
                   ],
                   { prompt: "Select a category" },
                   required: true %>

    </div>


    <div class="form-group">

      <%= f.label :content %>

      <%= f.text_area :content,
                      placeholder: "Write your post here...",
                      rows: 8,
                      required: true %>

    </div>


    <div class="form-actions">

      <%= f.submit "Publish Post", class: "btn" %>

      <%= link_to "Cancel",
                  posts_path,
                  class: "btn btn-secondary" %>

    </div>

  <% end %>

</div>