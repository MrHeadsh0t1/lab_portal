<div class="post-details">

  <div class="post-details-header">

    <%= link_to "← Back to Posts",
                posts_path,
                class: "back-link" %>

    <span class="category-badge">
      <%= @post.category %>
    </span>

  </div>


  <h1><%= @post.title %></h1>


  <div class="post-author post-details-author">

    <div class="user-avatar">
      <%= @post.user.username.first.upcase %>
    </div>

    <div>

      <strong>
        <%= @post.user.username %>
      </strong>

      <div class="post-time">
        Posted on
        <%= @post.created_at.strftime("%d/%m/%Y at %H:%M") %>
      </div>

    </div>

  </div>


  <div class="post-body">
    <%= simple_format(@post.content) %>
  </div>


  <% if @post.user == current_user %>

    <div class="post-owner-actions">

      <%= button_to "Delete Post",
                    post_path(@post),
                    method: :delete,
                    class: "btn btn-danger",
                    data: {
                      turbo_confirm: "Are you sure you want to delete this post?"
                    } %>

    </div>

  <% end %>

</div>