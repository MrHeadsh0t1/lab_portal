<div class="page-header">

  <div>
    <h1>Community Posts</h1>
    <p class="text-muted">
      Find posts from other students or share something with the community.
    </p>
  </div>

  <%= link_to "Create Post", new_post_path, class: "btn" %>

</div>


<div class="card search-panel">

  <%= form_with url: posts_path, method: :get do %>

    <div class="search-row">

      <div class="search-field">
        <%= label_tag :search, "Search" %>

        <%= text_field_tag :search,
                           params[:search],
                           placeholder: "Search posts..." %>
      </div>

      <div class="search-field">
        <%= label_tag :category, "Category" %>

        <%= select_tag :category,
                       options_for_select(
                         [
                           ["All Categories", ""],
                           ["Programming", "Programming"],
                           ["Databases", "Databases"],
                           ["Networks", "Networks"],
                           ["Other", "Other"]
                         ],
                         params[:category]
                       ) %>
      </div>

      <div class="search-actions">
        <%= submit_tag "Search", class: "btn" %>
        <%= link_to "Clear", posts_path, class: "btn btn-secondary" %>
      </div>

    </div>

  <% end %>

</div>


<div class="posts-list">

  <% if @posts.any? %>

    <% @posts.each do |post| %>

      <article class="post-card">

        <div class="post-header">

          <div class="post-author">

            <div class="user-avatar">
              <%= post.user.username.first.upcase %>
            </div>

            <div>
              <strong><%= post.user.username %></strong>

              <div class="post-time">
                <%= post.created_at.strftime("%d/%m/%Y %H:%M") %>
              </div>
            </div>

          </div>

          <span class="category-badge">
            <%= post.category %>
          </span>

        </div>

        <h2>
          <%= link_to post.title, post_path(post) %>
        </h2>

        <p class="post-content">
          <%= truncate(post.content, length: 250) %>
        </p>

        <div class="post-footer">

          <%= link_to "Read Post",
                      post_path(post),
                      class: "btn btn-secondary" %>

          <% if post.user == current_user %>

            <%= button_to "Delete",
                          post_path(post),
                          method: :delete,
                          class: "btn btn-danger",
                          data: {
                            turbo_confirm: "Are you sure you want to delete this post?"
                          } %>

          <% end %>

        </div>

      </article>

    <% end %>

  <% else %>

    <div class="empty-state">
      <h3>No posts found</h3>
      <p>Try changing your search filters or create a new post.</p>
    </div>

  <% end %>

</div>