<div class="page-header">

  <div>
    <h1>Users & Contacts</h1>

    <p class="text-muted">
      Find students and add them to your personal contacts.
    </p>
  </div>

</div>


<div class="users-grid">

  <% @users.each do |user| %>

    <div class="user-card">

      <div class="profile-avatar">
        <%= user.username.first.upcase %>
      </div>

      <h3><%= user.username %></h3>

      <p class="user-email">
        <%= user.email %>
      </p>


      <% if current_user.contact_users.exists?(user.id) %>

        <div class="contact-status">
          ✓ In your contacts
        </div>

        <div class="user-actions">

          <%= link_to "Message",
                      chat_path(user),
                      class: "btn" %>

          <% contact = current_user.contacts.find_by(contact_user_id: user.id) %>

          <%= button_to "Remove",
                        contact_path(contact),
                        method: :delete,
                        class: "btn btn-danger" %>

        </div>

      <% else %>

        <%= button_to "Add Contact",
                      contacts_path(contact_user_id: user.id),
                      method: :post,
                      class: "btn" %>

      <% end %>

    </div>

  <% end %>

</div>